# ===================================================================
# CineMagic Movie Ticket Booking System - .gitignore
# ===================================================================

# Compiled Java Class Files & Package Archives
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Build Directories & Artifacts
**/target/
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Java Crash Logs
hs_err_pid*
replay_pid*

# Logs & Temporary Files
*.log
logs/
*.tmp
*.bak
*.swp
*.swo
*~

# Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
.Trash-*

# IDE & Editor Files
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
.metadata/
bin/
*.launch

# Visual Studio Code
.vscode/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
nbactions.xml
nb-configuration.xml

# Application Cache (CineMagic Local Image Disk Cache)
.cinemagic/
.cache/
/cache/

# Environment & Local Secrets Overrides (Keep default app.properties tracked)
.env
.env.*
*.local
!backend/app.properties
!app/app.properties
!backend/src/main/resources/app.properties
!app/src/main/resources/app.properties
